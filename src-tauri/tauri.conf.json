{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sing Japanese",
  "version": "0.1.0",
  "identifier": "com.luskyle.sing-japanese",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "假名小调 · Sing Japanese",
        "width": 1200,
        "height": 850,
        "minWidth": 820,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux.desktop.hbs"
      }
    },
    "category": "Education",
    "shortDescription": "离线假名发音与听辨练习",
    "longDescription": "Learn hiragana and katakana with bundled public-domain recordings, listening exercises and local progress.",
    "copyright": "Pronunciation recordings: Hakatanoshio117117, public domain."
  }
}
